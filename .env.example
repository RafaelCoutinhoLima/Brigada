# Model provider: "anthropic" (default) or "openrouter" (OpenAI-compatible, has :free models).
MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Supabase connection URLs also work here.
DATABASE_URL=postgresql://brigada:brigada@localhost:5432/brigada
MODEL_STRONG=claude-sonnet-4-6
MODEL_FAST=claude-haiku-4-5
# With MODEL_PROVIDER=openrouter, use OpenRouter model ids that support tools, e.g.:
# MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b:free
# MODEL_FAST=nvidia/nemotron-3.5-lightning:free
MAX_AGENT_STEPS=10
TOOL_TIMEOUT_SECONDS=15
# API keys for POST /ask: "key=restaurant_ids;key2=ids", e.g. dev-key=1,2,3
API_KEYS=
# Local development only: the console connects by itself from this machine with this key.
CONSOLE_LOCAL_KEY=
